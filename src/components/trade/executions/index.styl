.executions
  padding: 16px
  background: rgba(27, 31, 39, 1)
  font-size: 13px

  h2
    margin: 0 0 8px
    font-size: 16px
    font-weight: 400

  button + button
    margin-left: 8px

  button:focus-visible
    outline: 2px solid currentColor

  p:empty
    margin: 0

  .executions-scroll
    max-height: 260px
    margin-top: 8px
    overflow: auto

    &::-webkit-scrollbar
      display: block
      width: 8px
      height: 8px

    &::-webkit-scrollbar-thumb
      display: block
      background: #777

  table
    border-collapse: collapse

  th, td
    padding: 6px
    text-align: left
    white-space: nowrap

  th
    position: sticky
    top: 0
    background: rgba(27, 31, 39, 1)
